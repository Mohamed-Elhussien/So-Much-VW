# انسخ الملف ده لـ .env.local (محليًا) أو حطّ نفس القيم في Vercel → Settings → Environment Variables

# عنوان الـ API للطلبات اللي بتتبعت من المتصفح (الأوردرات، الكاردات، ...).
# NEXT_PUBLIC_* بيتدمج وقت الـ build: لو غيّرته في Vercel لازم Redeploy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# عنوان الـ API للطلبات اللي بتتبعت من سيرفر Next.js (صفحة المنتج بعد التحويل لـ Server Component).
# من غير NEXT_PUBLIC_ فمش بيتبعت للمتصفح. في production بيفشل بوضوح لو مش مضبوط.
API_URL=http://127.0.0.1:4000

# دومينات صور المنتجات المسموحة (مفصولة بفاصلة). اطلعها بـ: node src/scripts/list-image-hosts.js
IMAGE_HOSTS=test1.somuchstores.com
