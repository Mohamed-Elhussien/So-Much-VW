# انسخ الملف ده لـ .env واملأ القيم الحقيقية. ما ترفعش .env على git أبدًا.

# ---- قاعدة البيانات ----
MONGODB_URI=
PORT=4000

# ---- CORS: عناوين الفرونت المسموحة (مفصولة بفاصلة، من غير / في الآخر) ----
# مثال production:  https://somuch.vercel.app,https://www.yourdomain.com
CLIENT_ORIGIN=http://localhost:3000

# ---- WooCommerce (staging دلوقتي، production وقت الإطلاق) ----
# مفتاح الـ REST API لازم يكون Read/Write (عشان الأوردرات)
WC_URL=https://test1.somuchstores.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ---- الأوردرات ----
SHIPPING_FEE=60            # لازم يطابق SHIPPING_FEE في frontend/app/checkout/page.jsx
WC_ORDER_STATUS=processing # أو on-hold لو عايز مراجعة يدوية قبل التجهيز

# ---- الاستضافة ----
# خلف proxy (Render/Railway/Fly...): ضبطه على 1 عشان الـ rate limit يشوف IP العميل الحقيقي
# TRUST_PROXY=1

# ⚠️ مشكلة DNS محلية فقط (sandbox). ما تفعّلوش في أي سيرفر حقيقي.
# FORCE_GOOGLE_DNS=true
